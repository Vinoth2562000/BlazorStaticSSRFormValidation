nd\" href b-y2xv0o98au>StaticSSRFormValidation</a></div></div>\r\n\r\n<input type=\"checkbox\" title=\"Navigation menu\" class=\"navbar-toggler\" b-y2xv0o98au>\r\n\r\n<div id=\"nav-scrollable\" class=\"nav-scrollable\" b-y2xv0o98au><nav class=\"nav flex-column\" b-y2xv0o98au><div class=\"nav-item px-3\" b-y2xv0o98au><a href=\"\" class=\"nav-link\"><span class=\"bi bi-house-door-fill-nav-menu\" aria-hidden=\"true\" b-y2xv0o98au></span> Home\r\n            </a></div>\r\n\r\n        <div class=\"nav-item px-3\" b-y2xv0o98au><a href=\"weather\" class=\"nav-link\"><span class=\"bi bi-list-nested-nav-menu\" aria-hidden=\"true\" b-y2xv0o98au></span> Weather\r\n            </a></div>\r\n\r\n        <div class=\"nav-item px-3\" b-y2xv0o98au><a href=\"registration\" class=\"nav-link active\" aria-current=\"page\"><span class=\"bi bi-check-circle-fill-nav-menu\" aria-hidden=\"true\" b-y2xv0o98au></span> Registration\r\n            </a></div></nav></div></div>\r\n\r\n    <main b-umf1oe95sx><div class=\"top-row px-4\" b-umf1oe95sx><a href=\"https://learn.microsoft.com/aspnet/core/\" target=\"_blank\" b-umf1oe95sx>About</a></div>\r\n\r\n        <article class=\"content px-4\" b-umf1oe95sx>\r\n\r\n<div class=\"container mt-5\"><div class=\"row\"><div class=\"col-md-8 mx-auto\"><h1>Registration Form - Static SSR Validation Test</h1>\r\n            <p class=\"text-muted\">\r\n                Test scenario: Browser feedback and server validation in a static SSR form.\r\n                <br>\r\n                <small>Try: invalid email, required fields, and reserved names (admin, system, etc.)</small></p><div id=\"submission-rejected\" class=\"alert alert-danger\" role=\"alert\"><strong>Registration rejected by server validation.</strong>\r\n                    Your Name, Email, and Age remain in the form so you can correct the error.\r\n                </div><form method=\"post\" action=\"/registration\"><input type=\"hidden\" name=\"_handler\" value=\"registrationForm\" />\r\n                \r\n                <div class=\"card mb-4\"><div class=\"card-header\"><h5>Form Fields</h5></div>\r\n                    <div class=\"card-body\"><div class=\"mb-3\"><label for=\"name\" class=\"form-label\">Name (required)</label>\r\n                            <input placeholder=\"Enter your name\" aria-invalid=\"true\" id=\"name\" name=\"Model.Name\" class=\"form-control invalid\" value=\"admin\" />\r\n                            <div data-valmsg-for=\"Model.Name\" data-valmsg-replace=\"true\" class=\"invalid-feedback d-block\">&#x27;Name&#x27; is a reserved name and cannot be used</div>\r\n                            <small class=\"form-text text-muted\">\r\n                                Note: \"admin\", \"system\", \"root\", \"test\", \"administrator\" are reserved names (server-only validation)\r\n                            </small></div>\r\n\r\n                        \r\n                        <div class=\"mb-3\"><label for=\"email\" class=\"form-label\">Email (required, must be valid)</label>\r\n                            <input placeholder=\"Enter your email\" id=\"email\" name=\"Model.Email\" class=\"form-control valid\" value=\"admin@gmail.com\" />\r\n                            <div data-valmsg-for=\"Model.Email\" data-valmsg-replace=\"true\" hidden class=\"invalid-feedback d-block\"></div>\r\n                            <small class=\"form-text text-muted\">\r\n                                Note: No native HTML constraints applied. Validation via DataAnnotations only.\r\n                            </small></div>\r\n\r\n                        \r\n                        <div class=\"mb-3\"><label for=\"age\" class=\"form-label\">Age (required, 18-120)</label>\r\n                            <input step=\"any\" type=\"number\" placeholder=\"Enter your age\" id=\"age\" name=\"Model.Age\" class=\"form-control valid\" value=\"30\" />\r\n                            <div data-valmsg-for=\"Model.Age\" data-valmsg-replace=\"true\" hidden class=\"invalid-feedback d-block\"></div></div></div></div>\r\n\r\n                \r\n                <div class=\"card mb-4\"><div class=\"card-header bg-danger text-white\"><h5 id=\"validation-summary-heading\">Validation Errors</h5></div>\r\n                    <div id=\"validation-summary\" class=\"card-body validation-summary-card\" role=\"alert\" aria-labelledby=\"validation-summary-heading\"><ul class=\"validation-errors validation-summary-errors\" data-valmsg-summary=\"true\"><li class=\"validation-message\">&#x27;Name&#x27; is a reserved name and cannot be used</li></ul>\r\n                        <div data-valmsg-for=\"Model.Name\" data-valmsg-replace=\"true\" class=\"server-validation-summary\">&#x27;Name&#x27; is a reserved name and cannot be used</div></div></div>\r\n\r\n                \r\n                <div class=\"d-flex gap-2\"><button type=\"submit\" class=\"btn btn-primary\">Submit Registration</button></div><blazor-client-validation-data data-rules=\"{&quot;fields&quot;:[{&quot;name&quot;:&quot;Model.Name&quot;,&quot;rules&quot;:[{&quot;name&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Name is required&quot;},{&quot;name&quot;:&quot;length&quot;,&quot;message&quot;:&quot;Name cannot exceed 50 characters&quot;,&quot;params&quot;:{&quot;max&quot;:&quot;50&quot;}}]},{&quot;name&quot;:&quot;Model.Email&quot;,&quot;rules&quot;:[{&quot;name&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Email is required&quot;},{&quot;name&quot;:&quot;email&quot;,&quot;message&quot;:&quot;Email must be a valid email address&quot;}]},{&quot;name&quot;:&quot;Model.Age&quot;,&quot;rules&quot;:[{&quot;name&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Age is required&quot;},{&quot;name&quot;:&quot;range&quot;,&quot;message&quot;:&quot;Age must be between 18 and 120&quot;,&quot;params&quot;:{&quot;min&quot;:&quot;18&quot;,&quot;max&quot;:&quot;120&quot;}}]}]}\"></blazor-client-validation-data></form></div></div></div></article></main></div>\r\n        <blazor-focus-on-navigate selector=\"h1\"></blazor-focus-on-navigate>\r\n    <script src=\"_framework/blazor.web.ev8z2seuww.js\"></script></body></html><!--Blazor-Server-Component-State:-->"
