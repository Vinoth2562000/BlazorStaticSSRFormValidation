            "text": "html, body {\r\n    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\r\n}\r\n\r\na, .btn-link {\r\n    color: #006bb7;\r\n}\r\n\r\n.btn-primary {\r\n    color: #fff;\r\n    background-color: #1b6ec2;\r\n    border-color: #1861ac;\r\n}\r\n\r\n.btn:focus, .btn:active:focus, .btn-link.nav-link:focus, .form-control:focus, .form-check-input:focus {\r\n  box-shadow: 0 0 0 0.1rem white, 0 0 0 0.25rem #258cfb;\r\n}\r\n\r\n.content {\r\n    padding-top: 1.1rem;\r\n}\r\n\r\nh1:focus {\r\n    outline: none;\r\n}\r\n\r\n.valid.modified:not([type=checkbox]) {\r\n    outline: 1px solid #26b050;\r\n}\r\n\r\n.invalid {\r\n    outline: 1px solid #e50000;\r\n}\r\n\r\n.validation-message {\r\n    color: #e50000;\r\n}\r\n\r\n.blazor-error-boundary {\r\n    background: url(data:image/svg+xml;base64,) no-repeat 1rem/1.8rem, #b32121;\r\n    padding: 1rem 1rem 1rem 3.7rem;\r\n    color: white;\r\n}\r\n\r\n    .blazor-error-boundary::after {\r\n        content: \"An error has occurred.\"\r\n    }\r\n\r\n.darker-border-checkbox.form-check-input {\r\n    border-color: #929292;\r\n}\r\n\r\n/* Validation styles for static SSR form */\r\n.form-control.is-invalid {\r\n    border-color: #dc3545;\r\n    background-image: none;\r\n}\r\n\r\n.form-control.is-invalid:focus {\r\n    border-color: #dc3545;\r\n    box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);\r\n}\r\n\r\n.invalid-feedback {\r\n    color: #dc3545;\r\n    font-weight: 500;\r\n    margin-top: 0.25rem;\r\n}\r\n\r\n/* Validation summary */\r\n.validation-errors {\r\n    margin-top: 1rem;\r\n}\r\n\r\n.validation-errors ul {\r\n    margin-bottom: 0;\r\n    padding-left: 1.5rem;\r\n}\r\n\r\n.validation-errors li {\r\n    margin-bottom: 0.25rem;\r\n}\r\n\r\n.server-validation-summary {\r\n    color: #e50000;\r\n}\r\n\r\n.validation-summary-card:has(.validation-summary-errors:not([hidden])) .server-validation-summary {\r\n    display: none;\r\n}\r\n\r\n/* Highlighted test checklist */\r\n.card-body ul li {\r\n    margin-bottom: 0.5rem;\r\n}\r\n\r\n.card-body ol li {\r\n    margin-bottom: 0.5rem;\r\n}\r\n}\r\n\r\n.form-floating > .form-control-plaintext::placeholder, .form-floating > .form-control::placeholder {\r\n    color: var(--bs-secondary-color);\r\n    text-align: end;\r\n}\r\n\r\n.form-floating > .form-control-plaintext:focus::placeholder, .form-floating > .form-control:focus::placeholder {\r\n    text-align: start;\r\n}\r\n"
