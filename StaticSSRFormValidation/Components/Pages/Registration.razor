@page "/registration"
@using System.Diagnostics
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using StaticSSRFormValidation.Models
@inject HttpClient Http

<PageTitle>Registration Form - Validation Test</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h1>Registration Form - Static SSR Validation Test</h1>
            <p class="text-muted">
                Test scenario: Browser feedback and server validation in a static SSR form.
                <br />
                <small>Try: invalid email, required fields, and reserved names (admin, system, etc.)</small>
            </p>

            <EditForm Model="@Model" FormName="registrationForm" OnValidSubmit="HandleValidSubmit" method="post" @key="RenderCount">
                <DataAnnotationsValidator />
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Form Fields</h5>
                    </div>
                    <div class="card-body">
                        <!-- Name Field -->
                        <div class="mb-3">
                            <label for="name" class="form-label">Name (required)</label>
                            <InputText 
                                id="name" 
                                @bind-Value="Model.Name" 
                                class="@($"form-control {(IsFieldInvalid("Name") ? "is-invalid" : "")}")" 
                                placeholder="Enter your name"
                                @onblur="@(() => MarkFieldTouched("Name"))" />
                            <ValidationMessage For="@(() => Model.Name)" class="invalid-feedback d-block" />
                            <small class="form-text text-muted">
                                Note: "admin", "system", "root", "test", "administrator" are reserved names (server-only validation)
                            </small>
                        </div>

                        <!-- Email Field -->
                        <div class="mb-3">
                            <label for="email" class="form-label">Email (required, must be valid)</label>
                            <InputText 
                                id="email" 
                                @bind-Value="Model.Email" 
                                class="@($"form-control {(IsFieldInvalid("Email") ? "is-invalid" : "")}")" 
                                placeholder="Enter your email"
                                @onblur="@(() => MarkFieldTouched("Email"))" />
                            <ValidationMessage For="@(() => Model.Email)" class="invalid-feedback d-block" />
                            <small class="form-text text-muted">
                                Note: No native HTML constraints applied. Validation via DataAnnotations only.
                            </small>
                        </div>

                        <!-- Age Field -->
                        <div class="mb-3">
                            <label for="age" class="form-label">Age (required, 18-120)</label>
                            <InputNumber 
                                id="age" 
                                @bind-Value="Model.Age" 
                                class="@($"form-control {(IsFieldInvalid("Age") ? "is-invalid" : "")}")" 
                                placeholder="Enter your age"
                                @onblur="@(() => MarkFieldTouched("Age"))" />
                            <ValidationMessage For="@(() => Model.Age)" class="invalid-feedback d-block" />
                        </div>
                    </div>
                </div>

                <!-- Validation Summary -->
                <div class="card mb-4 @(FormHasErrors ? "" : "d-none")">
                    <div class="card-header bg-danger text-white">
                        <h5>Validation Errors</h5>
                    </div>
                    <div class="card-body">
                        <ValidationSummary />
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Submit Registration</button>
                    <button type="reset" class="btn btn-secondary">Reset Form</button>
                </div>
            </EditForm>

            <!-- Success Confirmation -->
            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success mt-4" role="alert">
                    <h5>✓ Registration Successful!</h5>
                    <p>
                        <strong>Submitted Name:</strong> @SuccessMessage
                    </p>
                    <p class="mb-0 text-muted">
                        <small>This confirmation was generated after a successful server POST.</small>
                    </p>
                </div>
            }

            <!-- Server Response Information (for debugging) -->
            @if (!string.IsNullOrEmpty(DebugInfo))
            {
                <div class="card mt-4">
                    <div class="card-header">
                        <h6>Debug Information</h6>
                    </div>
                    <div class="card-body">
                        <small><pre>@DebugInfo</pre></small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private RegistrationModel Model = new();
    private string? SuccessMessage;
    private string? DebugInfo;
    private HashSet<string> TouchedFields = new();
    private int RenderCount = 0;

    private bool IsFieldInvalid(string fieldName)
    {
        return TouchedFields.Contains(fieldName);
    }

    private void MarkFieldTouched(string fieldName)
    {
        TouchedFields.Add(fieldName);
    }

    private bool FormHasErrors
    {
        get
        {
            var context = new ValidationContext(Model);
            return !Validator.TryValidateObject(Model, context, null, true);
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {   
            // Clear previous success message
            SuccessMessage = null;
            DebugInfo = null;

            var sw = Stopwatch.StartNew();

            // POST to server
            var response = await Http.PostAsJsonAsync("/api/register", Model);

            sw.Stop();

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                var result = System.Text.Json.JsonSerializer.Deserialize<RegistrationResponse>(jsonContent);
                SuccessMessage = result?.Name ?? "Unknown";
                DebugInfo = $"✓ Success\nStatus: {response.StatusCode}\nTime: {sw.ElapsedMilliseconds}ms\nName: {result?.Name}\nTimestamp: {result?.Timestamp:g}";
                
                // Reset form after successful submission
                Model = new();
                TouchedFields.Clear();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                DebugInfo = $"✗ Server Error\nStatus: {response.StatusCode}\nTime: {sw.ElapsedMilliseconds}ms\nResponse: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            DebugInfo = $"✗ Error: {ex.Message}";
        }
    }

    private void ResetForm()
    {
        Model = new();
        TouchedFields.Clear();
        SuccessMessage = null;
        DebugInfo = null;
        RenderCount++;
    }

    private void FillWithValidData()
    {
        Model = new()
        {
            Name = "John Doe",
            Email = "john@example.com",
            Age = 25
        };
        TouchedFields.Clear();
        SuccessMessage = null;
        DebugInfo = null;
    }

    private void FillWithReservedName()
    {
        Model = new()
        {
            Name = "admin",
            Email = "admin@example.com",
            Age = 30
        };
        TouchedFields.Clear();
        SuccessMessage = null;
        DebugInfo = null;
    }

    public class RegistrationResponse
    {
        public string? Name { get; set; }
        public DateTime Timestamp { get; set; }
    }
}
