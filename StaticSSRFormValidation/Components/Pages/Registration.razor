@page "/registration"
@using System.ComponentModel.DataAnnotations
@using StaticSSRFormValidation.Models

<PageTitle>Registration Form - Validation Test</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h1>Registration Form - Static SSR Validation Test</h1>
            <p class="text-muted">
                Test scenario: Browser feedback and server validation in a static SSR form.
                <br />
                <small>Try: invalid email, required fields, and reserved names (admin, system, etc.)</small>
            </p>

            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Success!</strong> @SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <EditForm Model="@Model" FormName="registrationForm" method="post" action="/api/register">
                <DataAnnotationsValidator />
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Form Fields</h5>
                    </div>
                    <div class="card-body">
                        <!-- Name Field -->
                        <div class="mb-3">
                            <label for="name" class="form-label">Name (required)</label>
                            <InputText 
                                id="name" 
                                @bind-Value="Model.Name" 
                                class="form-control" 
                                placeholder="Enter your name" />
                            <ValidationMessage For="@(() => Model.Name)" class="invalid-feedback d-block" />
                            <small class="form-text text-muted">
                                Note: "admin", "system", "root", "test", "administrator" are reserved names (server-only validation)
                            </small>
                        </div>

                        <!-- Email Field -->
                        <div class="mb-3">
                            <label for="email" class="form-label">Email (required, must be valid)</label>
                            <InputText 
                                id="email" 
                                @bind-Value="Model.Email" 
                                class="form-control" 
                                placeholder="Enter your email" />
                            <ValidationMessage For="@(() => Model.Email)" class="invalid-feedback d-block" />
                            <small class="form-text text-muted">
                                Note: No native HTML constraints applied. Validation via DataAnnotations only.
                            </small>
                        </div>

                        <!-- Age Field -->
                        <div class="mb-3">
                            <label for="age" class="form-label">Age (required, 18-120)</label>
                            <InputNumber 
                                id="age" 
                                @bind-Value="Model.Age" 
                                class="form-control" 
                                placeholder="Enter your age" />
                            <ValidationMessage For="@(() => Model.Age)" class="invalid-feedback d-block" />
                        </div>
                    </div>
                </div>

                <!-- Validation Summary -->
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5>Validation Errors</h5>
                    </div>
                    <div class="card-body">
                        <ValidationSummary />
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Submit Registration</button>
                </div>
            </EditForm>


        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Success { get; set; }

    [SupplyParameterFromQuery]
    public string? Name { get; set; }

    private RegistrationModel Model = new();
    private string? SuccessMessage { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Success) && Success.Equals("true", StringComparison.OrdinalIgnoreCase))
        {
            SuccessMessage = $"Registration successful! Thank you, {Name}. Your registration has been submitted.";
        }
    }

    public class RegistrationResponse
    {
        public string? Name { get; set; }
        public DateTime Timestamp { get; set; }
    }
}
