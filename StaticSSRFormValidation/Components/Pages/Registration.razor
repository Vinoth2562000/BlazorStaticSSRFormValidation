@page "/registration"
@using StaticSSRFormValidation.Models

<PageTitle>Registration Form - Validation Test</PageTitle>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <h1>Registration Form - Static SSR Validation Test</h1>
            <p class="text-muted">
                Test scenario: Browser feedback and server validation in a static SSR form.
                <br />
                <small>Try: invalid email, required fields, and reserved names (admin, system, etc.)</small>
            </p>

            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Success!</strong> @SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <EditForm Model="Model!" FormName="registrationForm" method="post" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Form Fields</h5>
                    </div>
                    <div class="card-body">
                        <!-- Name Field -->
                        <div class="mb-3">
                            <label for="name" class="form-label">Name (required)</label>
                            <InputText 
                                id="name" 
                                @bind-Value="Model!.Name"
                                class="form-control" 
                                placeholder="Enter your name" />
                            <ValidationMessage For="@(() => Model!.Name)" class="invalid-feedback d-block" />
                            <small class="form-text text-muted">
                                Note: "admin", "system", "root", "test", "administrator" are reserved names (server-only validation)
                            </small>
                        </div>

                        <!-- Email Field -->
                        <div class="mb-3">
                            <label for="email" class="form-label">Email (required, must be valid)</label>
                            <InputText 
                                id="email" 
                                @bind-Value="Model!.Email"
                                class="form-control" 
                                placeholder="Enter your email" />
                            <ValidationMessage For="@(() => Model!.Email)" class="invalid-feedback d-block" />
                            <small class="form-text text-muted">
                                Note: No native HTML constraints applied. Validation via DataAnnotations only.
                            </small>
                        </div>

                        <!-- Age Field -->
                        <div class="mb-3">
                            <label for="age" class="form-label">Age (required, 18-120)</label>
                            <InputNumber 
                                id="age" 
                                @bind-Value="Model!.Age"
                                class="form-control" 
                                placeholder="Enter your age" />
                            <ValidationMessage For="@(() => Model!.Age)" class="invalid-feedback d-block" />
                        </div>
                    </div>
                </div>

                <!-- Validation Summary -->
                <div class="card mb-4">
                    <div class="card-header bg-danger text-white">
                        <h5>Validation Errors</h5>
                    </div>
                    <div class="card-body validation-summary-card">
                        <ValidationSummary />
                        @* RC1 reconciles server-only errors into field-bound containers, so mirror Name in the summary card. *@
                        <ValidationMessage For="@(() => Model!.Name)" class="server-validation-summary" />
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Submit Registration</button>
                </div>
            </EditForm>


        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm(FormName = "registrationForm")]
    private RegistrationModel? Model { get; set; }

    private string? SuccessMessage { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    private void HandleValidSubmit()
    {
        SuccessMessage = $"Registration successful! Thank you, {Model!.Name}. Your registration has been submitted.";
    }
}
